# Copy to .env (local) and set the same names in Vercel. Never commit real values.

# Supabase project amlqvzmjiobvbhvbfdfi (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://amlqvzmjiobvbhvbfdfi.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: used by the PTG ingest, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of the app: http://localhost:3000 locally, https://padel-fantasy.betcomm.app in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth client. NOT read by the app: paste both into the Supabase dashboard
# (Authentication -> Sign In / Providers -> Google).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Web push. Generate once: the public key goes to browsers (NEXT_PUBLIC), the private one signs every push.
# Changing the pair invalidates every stored device subscription.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional: a mailto: or https URL the push services can contact. Defaults to https://padel-fantasy.betcomm.app
VAPID_SUBJECT=
# Vercel Cron sends this as `Authorization: Bearer <CRON_SECRET>` to /api/cron/push. Without it the route answers 401.
CRON_SECRET=
